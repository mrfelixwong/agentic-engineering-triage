#!/usr/bin/env bash
# Triage verification gate.
#
# Refuses the commit if the test suite fails or the eval drops below baseline.
# This is the gate Part 3 of the verification lesson installs. Install it with:
#
#   git config core.hooksPath scripts
#
# Do NOT symlink it into .git/hooks. Git runs a hook with $0 pointing at the
# symlink's own path, so "$(dirname "$0")/.." resolves to .git/ rather than the
# repo, the venv is never found, and the gate fails with "No module named
# pytest" on a green tree as loudly as on a red one. A gate that refuses
# everything teaches nothing and gets uninstalled by the first person it blocks.
#
# Uses the project venv if present.
set -euo pipefail

# Resolve the repo, not the hook's location — works however the hook is invoked.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
else
  PY="python3"
fi

echo "[gate] running tests..."
"$PY" -m pytest -q

echo "[gate] running eval..."
"$PY" -m eval.run

echo "[gate] ok"
