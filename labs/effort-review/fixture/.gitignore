.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# The student's change package. The folder and its README ship; everything the
# student saves into it is theirs and stays out of git. Being ignored also means
# `git clean -fd` leaves it alone; only `git clean -fdx` would reach it.
packet/*
!packet/README.md
!packet/provider-category-contract.md
!packet/lab-fixture.json
!packet/release-routing-contract.md
